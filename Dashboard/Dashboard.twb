            <column alias='revenue percentage' caption='Metric' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;revenue&quot;'>
              <calculation class='tableau' formula='&quot;revenue&quot;' />
              <aliases>
                <alias key='&quot;booking&quot;' value='booking percentage' />
                <alias key='&quot;revenue&quot;' value='revenue percentage' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bwgkvj0o043141128l9415vt62y'>
